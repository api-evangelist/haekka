    "_postman_id": "c7bbdafb-4c39-49ec-a358-9787827a70ba",
    "name": "Haekka Public Employee Trainings API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Haekka Public API provides read access to a company's employees, trainings, and employee-training records, plus the ability to assign trainings to employees and update employee-training completion. Haekka is a Slack-native microlearning and security-awareness training platform. API keys are generated in Haekka account settings and passed as a bearer token.\n\nContact Support:\n Name: Haekka Support\n Email: hello@haekka.com",
      "type": "text/plain"
    }
  }
